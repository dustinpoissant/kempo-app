{
  "name": "kempo-app",
  "version": "0.0.43",
  "description": "A framework for building Electron apps using kempo-ui",
  "type": "module",
  "main": "src/main/main.js",
  "bin": {
    "kempo-app": "bin/kempo-app.js",
    "kempo-interact": "scripts/interact.js",
    "kempo-icon": "bin/kempo-icon.js",
    "kempo-geticon": "bin/kempo-geticon.js",
    "kempo-listicons": "bin/kempo-listicons.js"
  },
  "scripts": {
    "start": "cd example && node ../bin/kempo-app.js",
    "dev": "cd example && node ../bin/kempo-app.js --dev",
    "buildStandalone": "cd example && node ../bin/kempo-app.js --build-standalone",
    "buildInstaller": "cd example && node ../bin/kempo-app.js --build-installer",
    "interact": "node scripts/interact.js",
    "test": "npx kempo-test",
    "build:docs": "node scripts/build-docs.js",
    "docs": "npx http-server docs -p 8080 -c-1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-app.git"
  },
  "author": "Dustin Poissant",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dustinpoissant/kempo-app/issues"
  },
  "homepage": "https://github.com/dustinpoissant/kempo-app#readme",
  "dependencies": {
    "app-builder-bin": "5.0.0-alpha.13",
    "chrome-remote-interface": "^0.34.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "kempo-ui": "^0.4.56",
    "rcedit": "^5.0.2"
  },
  "devDependencies": {
    "highlight.js": "^11.11.1",
    "js-beautify": "^2.0.3",
    "kempo-testing-framework": "^1.4.7"
  }
}
